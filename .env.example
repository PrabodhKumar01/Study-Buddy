# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Local LLM & Embeddings Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=gemma3:1b
EMBEDDING_MODEL=nomic-embed-text

# Optional Cloud LLM (for Vercel deployment or cloud inference)
# GROQ_API_KEY=your_groq_api_key_here
# CLOUD_MODEL_NAME=llama-3.1-8b-instant

# Storage Directories
DOCUMENTS_DIR=documents
DATA_DIR=data
VECTOR_STORE_PATH=data/vector_store.json
